# Copy to .env (git-ignored) and fill in. Never commit .env.
# YouCam API key from https://yce.makeupar.com/api-console/en/api-keys/  (sent as "Authorization: Bearer <key>")
YOUCAM_API_KEY=
# Secret Key shown once next to the API key at generation time (used for v1 RSA token auth; the server does not read it yet).
# Keep it here so it is not lost — the console never shows it again.
YOUCAM_SECRET_KEY=
# auto (live if a key is present, else mock) | mock | live
YOUCAM_MODE=auto
# Hard cap on units this server may spend in live mode (hackathon redeem code = 1000 units)
YOUCAM_UNIT_BUDGET=1000
# YOUCAM_API_BASE=https://yce-api-01.makeupar.com
PORT=5178
# DATA_DIR=.data
